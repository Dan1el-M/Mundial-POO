<%= render "shared/errors", resource: group %>

<%= form_with model: group, class: "stack" do |form| %>
  <div class="field">
    <%= form.label :letter, "Letter" %>
    <%= form.select :letter, Group::LETTERS, { prompt: "Select a letter" }, required: true %>
  </div>

  <div class="actions">
    <%= form.submit class: "button" %>
    <%= link_to "Back", groups_path, class: "button button-secondary" %>
  </div>
<% end %>
