<section class="page-header">
  <div>
    <h1>Group <%= @group.letter %></h1>
    <p>Standings, teams and registered group-stage matches.</p>
  </div>
  <div class="actions-inline">
    <%= link_to "Edit group", edit_group_path(@group), class: "button" %>
    <%= link_to "New group match", new_group_match_path(group_id: @group.id), class: "button button-secondary" %>
  </div>
</section>

<section class="card">
  <h2>Standings</h2>
  <table>
    <thead>
      <tr>
        <th>#</th>
        <th>Team</th>
        <th>Pts</th>
        <th>GF</th>
        <th>GA</th>
        <th>GD</th>
      </tr>
    </thead>
    <tbody>
      <% @standings.each_with_index do |team, index| %>
        <tr>
          <td><%= index + 1 %></td>
          <td><%= team.name %></td>
          <td><%= team.points %></td>
          <td><%= team.goals_for %></td>
          <td><%= team.goals_against %></td>
          <td><%= team.goal_difference %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>

<section class="card">
  <h2>Teams</h2>
  <ul class="plain-list">
    <% @group.teams.each do |team| %>
      <li><%= team.name %></li>
    <% end %>
  </ul>
</section>

<section class="card">
  <h2>Matches</h2>
  <% if @matches.any? %>
    <table>
      <thead>
        <tr>
          <th>Home</th>
          <th>Score</th>
          <th>Away</th>
        </tr>
      </thead>
      <tbody>
        <% @matches.each do |match| %>
          <tr>
            <td><%= match.home_team.name %></td>
            <td><%= match.completed? ? "#{match.home_score} - #{match.away_score}" : "Pending" %></td>
            <td><%= match.away_team.name %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>No group matches have been registered yet.</p>
  <% end %>
</section>
