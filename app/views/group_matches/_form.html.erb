<%= render "shared/errors", resource: match %>

<%= form_with model: match, class: "stack" do |form| %>
  <div class="field">
    <%= form.label :group_id, "Group" %>
    <%= form.collection_select :group_id, groups, :id, :letter, prompt: "Select a group", required: true %>
  </div>

  <div class="field">
    <%= form.label :home_team_id, "Home team" %>
    <%= form.collection_select :home_team_id, teams, :id, :name, prompt: "Select the home team", required: true %>
  </div>

  <div class="field">
    <%= form.label :away_team_id, "Away team" %>
    <%= form.collection_select :away_team_id, teams, :id, :name, prompt: "Select the away team", required: true %>
  </div>

  <div class="field-grid">
    <div class="field">
      <%= form.label :home_score, "Home goals" %>
      <%= form.number_field :home_score, min: 0 %>
    </div>
    <div class="field">
      <%= form.label :away_score, "Away goals" %>
      <%= form.number_field :away_score, min: 0 %>
    </div>
  </div>

  <div class="actions">
    <%= form.submit class: "button" %>
    <%= link_to "Back", group_matches_path, class: "button button-secondary" %>
  </div>
<% end %>
