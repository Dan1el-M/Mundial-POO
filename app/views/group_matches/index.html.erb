<header class="mb-section-margin">
    <h1 class="font-headline-lg text-headline-lg text-primary-container">Programación de Partidos - Fase de Grupos</h1>
    <p class="font-body-md text-body-md text-on-surface-variant mt-2">Valida que cada grupo tenga 4 selecciones para habilitar el registro de encuentros.</p>
  </header>

  <% total_required = 48 %>
  <% total_registered = @groups.map { |g| g.teams.size }.sum %>
  <% complete_groups = @groups.select { |g| g.teams.size == 4 } %>
  <% incomplete_groups = @groups.select { |g| g.teams.size < 4 } %>

  <div class="mb-card-gap">
    <% if incomplete_groups.any? %>
      <div class="bg-error-container border border-error/20 p-6 rounded-xl flex items-center gap-6 mb-card-gap shadow-sm">
        <div class="bg-error text-white w-16 h-16 rounded-full flex items-center justify-center flex-shrink-0">
          <span class="material-symbols-outlined text-[32px]" style="font-variation-settings: 'FILL' 1;">warning</span>
        </div>
        <div class="flex-grow">
          <h3 class="font-headline-md text-headline-md text-on-error-container mb-1">Acción requerida: Grupos incompletos</h3>
          <p class="font-body-md text-body-md text-on-error-container opacity-90">Hay <%= incomplete_groups.size %> grupo(s) incompletos. Asigna las selecciones faltantes para habilitar el registro automático de partidos.</p>
        </div>
      </div>
    <% else %>
      <div class="bg-emerald-50 border border-emerald-200 p-6 rounded-xl flex items-center gap-6 mb-card-gap shadow-sm">
        <div class="bg-emerald-600 text-white w-16 h-16 rounded-full flex items-center justify-center flex-shrink-0">
          <span class="material-symbols-outlined text-[32px]" style="font-variation-settings: 'FILL' 1;">check_circle</span>
        </div>
        <div class="flex-grow">
          <h3 class="font-headline-md text-headline-md text-black mb-1 font-black">Todos los grupos completos</h3>
          <p class="font-body-md text-body-md text-black opacity-90">Se han registrado las 48 selecciones. Ya puedes proceder a registrar los partidos por grupo.</p>
        </div>
      </div>
    <% end %>

    <div class="mb-card-gap">
      <div class="flex justify-between items-end mb-6">
        <h4 class="font-title-lg text-title-lg text-primary flex items-center gap-2">Estado por Grupos <span class="bg-surface-container-high text-on-surface-variant px-3 py-1 rounded-full text-label-sm"><%= total_registered %> / <%= total_required %> Selecciones</span></h4>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <% @groups.each do |group| %>
          <% complete = group.teams.size == 4 %>
          <div class="bg-white p-5 rounded-lg border border-outline-variant shadow-sm <%= complete ? 'group-card-complete' : 'group-card-incomplete bg-red-50/10' %>">
            <div class="flex justify-between items-start mb-4">
              <span class="font-display-lg text-[28px] text-primary"><%= group.letter %></span>
              <span class="material-symbols-outlined <%= complete ? 'text-green-500' : 'text-error' %>" style="font-variation-settings: 'FILL' 1;"><%= complete ? 'check_circle' : 'error' %></span>
            </div>
            <p class="text-label-sm font-label-sm <%= complete ? 'text-green-600' : 'text-error' %> mb-2 uppercase tracking-wider"><%= complete ? 'Completo' : 'Incompleto' %> <%= "(#{group.teams.size}/4)" %></p>
            <% if complete %>
              <p class="font-body-md text-body-md text-on-surface-variant mb-3">Equipos: <%= group.teams.map { |t| t.acronym.present? ? t.acronym.upcase : t.name.truncate(10) }.join(', ') %></p>
              
            <% else %>
              <p class="font-body-md text-body-md text-on-surface-variant">Faltan <%= 4 - group.teams.size %> equipo(s)</p>
              <button class="mt-3 px-4 py-2 rounded-lg border border-outline-variant text-on-surface-variant bg-surface-container-low cursor-not-allowed" disabled>Registrar Partidos</button>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <div class="mt-8 pt-6 border-t border-outline-variant flex justify-between items-center">
      <div class="flex items-center gap-2 text-on-surface-variant font-body-md text-body-md">
        <span class="material-symbols-outlined">info</span>
        <% if total_registered < total_required %>
          Se requieren <%= total_required - total_registered %> selecciones adicionales para proceder.
        <% else %>
          Todas las selecciones registradas. Procede a generar el calendario de partidos.
        <% end %>
      </div>
      <div class="flex gap-4">
        <%= link_to 'Gestionar Selecciones', teams_path, class: 'bg-primary-container text-on-primary-container px-6 py-3 rounded-lg font-title-lg text-title-lg hover:bg-opacity-90 transition-all flex items-center gap-2' %>
        <% if incomplete_groups.any? %>
          <button class="bg-outline text-white/50 px-8 py-3 rounded-lg font-title-lg text-title-lg cursor-not-allowed flex items-center gap-2" disabled>
            <span class="material-symbols-outlined">event_note</span>
            Generar Calendario de Partidos
          </button>
        <% else %>
          <%= button_to generate_calendar_group_matches_path, method: :post, class: 'bg-primary text-white px-8 py-3 rounded-lg font-title-lg text-title-lg flex items-center gap-2' do %>
            <span class="material-symbols-outlined">event_note</span>
            Generar Calendario de Partidos
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

<style>
  .group-card-complete { border-left: 4px solid #10B981; }
  .group-card-incomplete { border-left: 4px solid #E30613; }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const btn = document.getElementById('generate-calendar-btn');
    if (!btn) return;
    btn.addEventListener('click', function() {
      alert('Funcionalidad de generación de calendario pendiente. Implementa la acción en el controlador si deseas ejecutar automáticamente.');
    });
  });
</script>
