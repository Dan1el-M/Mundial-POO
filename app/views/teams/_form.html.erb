<%= render "shared/errors", resource: team %>

<%= form_with model: team, class: "stack" do |form| %>
  <div class="field">
    <%= form.label :name, "Country name" %>
    <%= form.text_field :name, required: true %>
  </div>

  <div class="field">
    <%= form.label :group_id, "Group" %>
    <%= form.collection_select :group_id, groups, :id, :letter, prompt: "Select a group", required: true %>
  </div>

  <div class="actions">
    <%= form.submit class: "button" %>
    <%= link_to "Back", teams_path, class: "button button-secondary" %>
  </div>
<% end %>
