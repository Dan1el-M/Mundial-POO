<section class="page-header">
  <div>
    <h1>Teams</h1>
    <p>Manage the 48 national teams and their group assignments.</p>
  </div>
  <%= link_to "New team", new_team_path, class: "button" %>
</section>

<% @groups.each do |group| %>
  <section class="card">
    <h2>Group <%= group.letter %></h2>
    <table>
      <thead>
        <tr>
          <th>Team</th>
          <th>Points</th>
          <th>GF</th>
          <th>GA</th>
          <th>GD</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% group.teams.each do |team| %>
          <tr>
            <td><%= team.name %></td>
            <td><%= team.points %></td>
            <td><%= team.goals_for %></td>
            <td><%= team.goals_against %></td>
            <td><%= team.goal_difference %></td>
            <td class="actions-inline">
              <%= link_to "Edit", edit_team_path(team), class: "button button-small" %>
              <%= button_to "Delete", team_path(team), method: :delete, class: "button button-danger button-small", form: { data: { turbo_confirm: "Delete #{team.name}?" } } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>
<% end %>
