<header class="mb-section-margin">
  <h1 class="font-headline-lg text-headline-lg text-primary-container">Gestión de Selecciones y Grupos</h1>
  <p class="font-body-md text-body-md text-on-surface-variant mt-2">Configura los participantes y la estructura competitiva del torneo mundial.</p>
</header>

<%# Mostrar errores de validación %>
<% if defined?(@validation_errors) && @validation_errors.present? %>
  <div class="mb-6">
    <div class="bg-error-container border border-error/20 p-4 rounded-lg">
      <h3 class="font-headline-md text-on-error-container mb-2">Se encontraron los siguientes errores:</h3>
      <ul class="list-disc pl-5 text-on-error-container">
        <% @validation_errors.each do |err| %>
          <li><%= err %></li>
        <% end %>
      </ul>
    </div>
  </div>
<% elsif flash[:alert].present? %>
  <div class="mb-6">
    <div class="bg-error-container border border-error/20 p-4 rounded-lg">
      <p class="text-on-error-container"><%= flash[:alert] %></p>
    </div>
  </div>
<% end %>

<div class="grid grid-cols-1 xl:grid-cols-12 gap-card-gap items-start">
  <section class="xl:col-span-4 space-y-card-gap">
    <div class="bg-surface-container-lowest border border-outline-variant rounded-xl shadow-sm p-4">
      <div class="flex items-center gap-2 mb-4">
        <span class="material-symbols-outlined text-primary-container" style="font-variation-settings: 'FILL' 1;">add_moderator</span>
        <h2 class="font-title-lg text-title-lg text-primary-container">Nueva Selección</h2>
      </div>
      <%= form_with model: (@team || Team.new), url: teams_path, local: true, class: "space-y-4", data: { turbo: false } do |f| %>
        <div class="grid grid-cols-2 gap-4">
          <div class="space-y-1">
            <%= f.label :name, "Nombre del País", class: "font-label-sm text-label-sm text-on-surface-variant block" %>
            <%= f.text_field :name, placeholder: "Ej. México", class: "w-full border-outline-variant rounded-lg p-2.5 focus:ring-2 focus:ring-primary-fixed focus:border-primary-fixed transition-all" %>
          </div>
          <div class="space-y-1">
            <label class="font-label-sm text-label-sm text-on-surface-variant block">Acrónimo</label>
            <%= f.text_field :acronym, placeholder: "Ej. MEX", class: "w-full border-outline-variant rounded-lg p-2.5 focus:ring-2 focus:ring-primary-fixed transition-all" %>
          </div>
        </div>
        <div class="space-y-1">
          <label class="font-label-sm text-label-sm text-on-surface-variant block font-bold">Grupo Asignado</label>
          <%= f.collection_select :group_id, @groups, :id, :letter, { prompt: "Seleccione un grupo" }, { id: "team_group_id", class: "w-full border-outline-variant rounded-lg p-3 bg-surface-container-low focus:ring-2 focus:ring-primary-fixed transition-all font-semibold" } %>
        </div>
        <button class="w-full bg-[#E30613] text-white py-3 rounded-lg font-bold hover:bg-[#c00510] transition-colors shadow-sm flex items-center justify-center gap-2 mt-4" type="submit"><span class="material-symbols-outlined">save</span>Registrar Selección</button>
      <% end %>
    </div>

    <div class="bg-primary-container text-white p-6 rounded-xl overflow-hidden relative group cursor-pointer shadow-lg">
      <div class="relative z-10">
        <h2 class="font-title-lg text-title-lg mb-2">Configuración de Grupos</h2>
        <p class="text-sm opacity-80 mb-4">Ajusta la capacidad y sedes principales por grupo (A-L).</p>
        <button onclick="openGroupModal()" 
            class="flex items-center gap-2 bg-secondary-container text-on-secondary-container px-4 py-2 rounded-full font-bold text-sm hover:scale-105 transition-transform w-[100%]">
            Editar Estructura
        </button>
      </div>
      <div class="absolute -right-10 -bottom-10 opacity-10 group-hover:scale-110 transition-transform duration-500">
        <span class="material-symbols-outlined text-[160px]">grid_view</span>
      </div>
    </div>
  </section>

  <section class="xl:col-span-8 space-y-card-gap">
    <div class="flex flex-wrap items-center justify-between gap-4 bg-white p-4 rounded-xl border border-outline-variant">
      <div class="flex items-center gap-2 overflow-x-auto pb-2 md:pb-0 scrollbar-hide" id="group-filter-buttons">
        <span class="text-xs font-bold text-on-surface-variant uppercase px-2">Filtrar:</span>
        <button type="button" data-group-letter="all" class="whitespace-nowrap px-4 py-1.5 rounded-full bg-primary-container text-white text-sm font-semibold">Todos</button>
        <% @groups.each do |group| %>
          <button type="button" data-group-letter="<%= group.letter %>" class="whitespace-nowrap px-4 py-1.5 rounded-full bg-surface-container-high text-on-surface-variant text-sm hover:bg-outline-variant transition-colors">Grupo <%= group.letter %></button>
        <% end %>
      </div>
    </div>

    <div class="bg-surface-container-lowest border border-outline-variant rounded-xl overflow-hidden shadow-sm">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-primary-container text-white">
              <th class="px-6 py-4 font-headline-md text-label-sm uppercase tracking-wider">Selección</th>
              <th class="px-6 py-4 font-headline-md text-label-sm uppercase tracking-wider">Grupo</th>
              <th class="px-6 py-4 font-headline-md text-label-sm uppercase tracking-wider text-center">Pts</th>
              <th class="px-6 py-4 font-headline-md text-label-sm uppercase tracking-wider text-center">GF/GC</th>
              <th class="px-6 py-4 font-headline-md text-label-sm uppercase tracking-wider">Estatus</th>
              <th class="px-6 py-4 font-headline-md text-label-sm uppercase tracking-wider text-right">Acciones</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-outline-variant">
            <% @teams.each do |team| %>
              <tr class="hover:bg-surface-container-low transition-colors group" data-team-id="<%= team.id %>" data-team-name="<%= j team.name %>" data-team-acronym="<%= j team.acronym %>" data-team-group-id="<%= team.group_id %>" data-team-group-letter="<%= team.group.letter %>">
                <td class="px-6 py-4">
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-7 bg-surface-container rounded border border-outline-variant overflow-hidden flex items-center justify-center">
                      <span class="font-bold text-sm text-primary-container"><%= team.acronym.present? ? team.acronym.upcase : team.name.first(2).upcase %></span>
                    </div>
                    <span class="font-title-lg text-body-lg text-primary-container font-bold"><%= team.name %></span>
                  </div>
                </td>
                <td class="px-6 py-4">
                  <span class="inline-flex px-3 py-1 bg-primary/10 text-primary-container rounded-full text-xs font-bold">Grupo <%= team.group.letter %></span>
                </td>
                <td class="px-6 py-4 text-center font-bold"><%= team.points %></td>
                <td class="px-6 py-4 text-center text-on-surface-variant font-body-md text-body-md"><%= team.goals_for %> / <%= team.goals_against %></td>
                <td class="px-6 py-4">
                  <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 text-[10px] font-bold uppercase">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                    Activo
                  </span>
                </td>
                <td class="px-6 py-4 text-right">
                  <div class="flex justify-end gap-2">
                    <button type="button" onclick="openEditTeamModal(this.closest('tr'))" class="p-2 hover:bg-primary-container/10 text-primary-container rounded-lg transition-colors group-hover:scale-110">
                      <span class="material-symbols-outlined text-lg">edit</span>
                    </button>
                    <button type="button" onclick="openDeleteTeamModal(this.closest('tr'))" class="p-2 hover:bg-error-container/20 text-error rounded-lg transition-colors group-hover:scale-110">
                      <span class="material-symbols-outlined text-lg">delete</span>
                    </button>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="bg-surface-container px-6 py-3 border-t border-outline-variant flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <span class="text-xs text-on-surface-variant">Mostrando <%= @teams.size %> de <%= @total_teams %> selecciones</span>
        <div class="flex gap-1">
          <% if @current_page > 1 %>
            <%= link_to teams_path(page: @current_page - 1), class: "p-1.5 border border-outline-variant rounded hover:bg-white transition-colors" do %>
              <span class="material-symbols-outlined text-sm">chevron_left</span>
            <% end %>
          <% else %>
            <button class="p-1.5 border border-outline-variant rounded text-on-surface-variant opacity-50" disabled>
              <span class="material-symbols-outlined text-sm">chevron_left</span>
            </button>
          <% end %>
          <div class="px-2 py-1 rounded-full border border-outline-variant text-xs text-on-surface-variant flex items-center">Página <%= @current_page %> / <%= @total_pages %></div>
          <% if @current_page < @total_pages %>
            <%= link_to teams_path(page: @current_page + 1), class: "p-1.5 border border-outline-variant rounded hover:bg-white transition-colors" do %>
              <span class="material-symbols-outlined text-sm">chevron_right</span>
            <% end %>
          <% else %>
            <button class="p-1.5 border border-outline-variant rounded text-on-surface-variant opacity-50" disabled>
              <span class="material-symbols-outlined text-sm">chevron_right</span>
            </button>
          <% end %>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4" id="group-card-grid">
      <% @groups.each do |group| %>
        <div class="bg-white p-4 rounded-xl border-l-4 border-primary-container shadow-sm flex flex-col justify-between h-32">
          <div class="flex justify-between items-start">
            <span class="font-headline-md text-label-sm uppercase text-on-surface-variant">Grupo <%= group.letter %></span>
            <span class="text-xs font-bold text-on-primary-container bg-primary-fixed px-2 py-0.5 rounded"><%= group.teams.count %>/4</span>
          </div>
          <div class="text-xs text-on-surface-variant mt-2 flex flex-col gap-1">
            <div class="flex items-center gap-1"><span class="w-1.5 h-1.5 bg-green-500 rounded-full"></span> <%= group.teams.map { |t| (t.acronym.present? ? t.acronym.upcase : t.name[0,3].upcase) }.join(', ') %></div>
          </div>
          <button class="text-xs font-bold text-primary-container mt-auto hover:underline text-left"><%= link_to 'Ver detalles →', group_path(group), class: 'text-primary-container' %></button>
        </div>
      <% end %>
      <button type="button" onclick="openGroupModal()" class="group p-4 rounded-xl border-2 border-dashed border-outline-variant hover:border-primary-fixed-dim transition-all flex flex-col items-center justify-center gap-2 bg-surface-container-low/50 h-32">
        <div class="w-8 h-8 rounded-full bg-outline-variant/30 flex items-center justify-center group-hover:bg-primary-fixed group-hover:scale-110 transition-all">
          <span class="material-symbols-outlined text-on-surface-variant group-hover:text-primary-container">add</span>
        </div>
        <span class="text-xs font-bold text-on-surface-variant">Nuevo Grupo</span>
      </button>
    </div>
  </section>
</div>

<script>
  const gfInput = document.querySelector('#team_goals_for');
  const gcInput = document.querySelector('#team_goals_against');
  const dgOutput = document.querySelector('#team_goal_difference');

  const updateGoalDifference = () => {
    if (gfInput && gcInput && dgOutput) {
      dgOutput.value = parseInt(gfInput.value || 0) - parseInt(gcInput.value || 0);
    }
  };

  if (gfInput && gcInput) {
    gfInput.addEventListener('input', updateGoalDifference);
    gcInput.addEventListener('input', updateGoalDifference);
  }
</script>
        if (gfInput && gcInput) {
          gfInput.addEventListener('input', updateGoalDifference);
          gcInput.addEventListener('input', updateGoalDifference);
        }

        const groupModal = document.getElementById('group-modal');
        const groupSelect = document.getElementById('group-select');
        const teamGroupSelect = document.getElementById('team_group_id');
        const groupFilterButtons = document.getElementById('group-filter-buttons');
        const groupCardGrid = document.getElementById('group-card-grid');
        const notificationDrawer = document.getElementById('notification-drawer');
        const notificationTitle = document.getElementById('notification-title');
        const notificationMessage = document.getElementById('notification-message');
        const deleteTeamModal = document.getElementById('delete-team-modal');
        const deleteTeamName = document.getElementById('delete-team-name');
        const deleteTeamGroup = document.getElementById('delete-team-group');
        const deleteTeamForm = document.getElementById('delete-team-form');
        const editTeamModal = document.getElementById('edit-team-modal');
        const editTeamForm = document.getElementById('edit-team-form');
        const editTeamNameInput = document.getElementById('edit-team-name-input');
        const editTeamAcronymInput = document.getElementById('edit-team-acronym-input');
        const editTeamGroupInput = document.getElementById('edit-team-group-input');

        const ALL_GROUP_LETTERS = ["A","B","C","D","E","F","G","H","I","J","K","L"];

        const openGroupModal = () => {
          if (groupModal) {
            groupModal.classList.remove('hidden');
          }
        };

        const closeGroupModal = () => {
          if (groupModal) {
            groupModal.classList.add('hidden');
          }
        };

        const buildGroupSelectOptions = (selectEl, groups, useIdValue = false) => {
          if (!selectEl) return;
          const options = groups.map(group => {
            const value = useIdValue ? group.id : group.letter;
            return `<option value="${value}">Grupo ${group.letter}</option>`;
          }).join('');
          const placeholder = '<option value="">Seleccione un grupo</option>';
          selectEl.innerHTML = placeholder + options;
        };

        const updateGroupsUI = groups => {
          if (!groups || !Array.isArray(groups)) return;
          const orderedGroups = groups.slice().sort((a, b) => a.letter.localeCompare(b.letter));

          if (groupFilterButtons) {
            groupFilterButtons.innerHTML = '<span class="text-xs font-bold text-on-surface-variant uppercase px-2">Filtrar:</span>' +
              '<button type="button" data-group-letter="all" class="whitespace-nowrap px-4 py-1.5 rounded-full bg-primary-container text-white text-sm font-semibold">Todos</button>' +
              orderedGroups.map(group => {
                return `<button type="button" data-group-letter="${group.letter}" class="whitespace-nowrap px-4 py-1.5 rounded-full bg-surface-container-high text-on-surface-variant text-sm hover:bg-outline-variant transition-colors">Grupo ${group.letter}</button>`;
              }).join('');
          }

          if (groupCardGrid) {
            groupCardGrid.innerHTML = orderedGroups.map(group => {
              const teamNames = (group.teams || []).slice(0, 4).map(team => {
                return team.acronym && team.acronym.trim().length > 0 ? team.acronym.toUpperCase() : team.name.substring(0, 3).toUpperCase();
              }).join(', ');
              return `
                <div class="bg-white p-4 rounded-xl border-l-4 border-primary-container shadow-sm flex flex-col justify-between h-32">
                  <div class="flex justify-between items-start">
                    <span class="font-headline-md text-label-sm uppercase text-on-surface-variant">Grupo ${group.letter}</span>
                    <span class="text-xs font-bold text-on-primary-container bg-primary-fixed px-2 py-0.5 rounded">${group.teams.length}/4</span>
                  </div>
                  <div class="text-xs text-on-surface-variant mt-2 flex flex-col gap-1">
                    <div class="flex items-center gap-1"><span class="w-1.5 h-1.5 bg-green-500 rounded-full"></span> ${teamNames}</div>
                  </div>
                  <button type="button" class="text-xs font-bold text-primary-container mt-auto hover:underline text-left">Ver detalles →</button>
                </div>`;
            }).join('') + `
              <button type="button" onclick="openGroupModal()" class="group p-4 rounded-xl border-2 border-dashed border-outline-variant hover:border-primary-fixed-dim transition-all flex flex-col items-center justify-center gap-2 bg-surface-container-low/50 h-32">
                <div class="w-8 h-8 rounded-full bg-outline-variant/30 flex items-center justify-center group-hover:bg-primary-fixed group-hover:scale-110 transition-all">
                  <span class="material-symbols-outlined text-on-surface-variant group-hover:text-primary-container">add</span>
                </div>
                <span class="text-xs font-bold text-on-surface-variant">Nuevo Grupo</span>
              </button>
            `;
          }

          const usedLetters = orderedGroups.map(group => group.letter);
          const availableLetters = ALL_GROUP_LETTERS.filter(letter => !usedLetters.includes(letter));
          if (groupSelect) {
            const options = availableLetters.map(letter => `<option value="${letter}">Grupo ${letter}</option>`).join('');
            groupSelect.innerHTML = '<option value="">Seleccione un grupo</option>' + options;
          }

          if (teamGroupSelect) {
            buildGroupSelectOptions(teamGroupSelect, orderedGroups, true);
          }
        };

        const fetchGroups = async () => {
          const response = await fetch('<%= groups_path(format: :json) %>', {
            headers: { 'Accept': 'application/json' }
          });
          if (!response.ok) return null;
          return await response.json();
        };

        const refreshGroups = async () => {
          const groups = await fetchGroups();
          if (groups) {
            updateGroupsUI(groups);
          }
        };

        const applyGroupFilter = groupLetter => {
          const rows = document.querySelectorAll('tbody tr[data-team-group-letter]');
          rows.forEach(row => {
            if (!groupLetter || groupLetter === 'all' || row.dataset.teamGroupLetter === groupLetter) {
              row.classList.remove('hidden');
            } else {
              row.classList.add('hidden');
            }
          });
        };

        const highlightFilterButton = clicked => {
          if (!groupFilterButtons) return;
          groupFilterButtons.querySelectorAll('button[data-group-letter]').forEach(button => {
            button.classList.remove('bg-primary-container', 'text-white', 'font-semibold');
            button.classList.add('bg-surface-container-high', 'text-on-surface-variant');
          });
          if (clicked) {
            clicked.classList.remove('bg-surface-container-high', 'text-on-surface-variant');
            clicked.classList.add('bg-primary-container', 'text-white', 'font-semibold');
          }
        };

        if (groupFilterButtons) {
          groupFilterButtons.addEventListener('click', event => {
            const button = event.target.closest('button[data-group-letter]');
            if (!button) return;
            const groupLetter = button.dataset.groupLetter;
            applyGroupFilter(groupLetter);
            highlightFilterButton(button);
          });
        }

        const closeDeleteModal = () => {
          if (deleteTeamModal) deleteTeamModal.classList.add('hidden');
        };

        const openDeleteTeamModal = row => {
          if (!row || !deleteTeamModal) return;
          const teamId = row.dataset.teamId;
          deleteTeamName.textContent = row.dataset.teamName || 'esta selección';
          deleteTeamGroup.textContent = row.dataset.teamGroupLetter || 'Grupo';
          deleteTeamForm.action = `/teams/${teamId}`;
          deleteTeamModal.classList.remove('hidden');
        };

        const closeEditModal = () => {
          if (editTeamModal) editTeamModal.classList.add('hidden');
        };

        const openEditTeamModal = row => {
          console.log('teamId:', row?.dataset?.teamId);
          if (!row || !editTeamModal) return;
          const teamId = row.dataset.teamId;
          editTeamNameInput.value = row.dataset.teamName || '';
          editTeamAcronymInput.value = row.dataset.teamAcronym || '';
          editTeamGroupInput.value = row.dataset.teamGroupId || '';
          const groupHidden = document.getElementById('edit-team-group-hidden');
          if (groupHidden) groupHidden.value = row.dataset.teamGroupId || '';
          editTeamForm.action = `/teams/${teamId}`;
          editTeamModal.classList.remove('hidden');
        };

        const showNotification = (title, message, type = 'success') => {
          if (!notificationDrawer || !notificationTitle || !notificationMessage) return;

          notificationTitle.textContent = title;
          notificationMessage.textContent = message;

          const iconContainer = notificationDrawer.querySelector('.w-10.h-10');
          const icon = iconContainer.querySelector('.material-symbols-outlined');

          if (type === 'alert') {
            iconContainer.className = 'w-10 h-10 rounded-full bg-error-container flex items-center justify-center flex-shrink-0';
            icon.className = 'material-symbols-outlined text-error';
            icon.textContent = 'warning';
          } else {
            iconContainer.className = 'w-10 h-10 rounded-full bg-emerald-100 flex items-center justify-center flex-shrink-0';
            icon.className = 'material-symbols-outlined text-emerald-600';
            icon.textContent = 'check_circle';
          }

          notificationDrawer.classList.remove('hidden');
          setTimeout(() => notificationDrawer.classList.add('hidden'), 4500);
        };

        const groupForm = document.getElementById('group-add-form');
        if (groupForm) {
          groupForm.addEventListener('submit', async event => {
            event.preventDefault();

            if (!groupSelect || !groupSelect.value) {
              showNotification('Seleccione un grupo', 'Debes elegir una opción antes de agregar.', 'alert');
              return;
            }

            const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
            const formData = new FormData();
            formData.append('group[letter]', groupSelect.value);

            const response = await fetch('<%= groups_path %>', {
              method: 'POST',
              headers: {
                'X-CSRF-Token': csrfToken,
                'Accept': 'application/json'
              },
              body: formData,
              credentials: 'same-origin'
            });

            if (response.ok) {
              const data = await response.json().catch(() => null);
              closeGroupModal();
              showNotification('Grupo agregado', data?.message || `Grupo ${groupSelect.value} agregado correctamente.`);
              if (groupSelect) groupSelect.value = '';
              await refreshGroups();
            } else {
              const error = await response.json().catch(() => null);
              showNotification('Error al agregar grupo', error?.message || 'No se pudo agregar el grupo.', 'alert');
            }
          });
        }
    </script>
