<section class="page-header">
  <div>
    <h1>FIFA World Cup 2026 Dashboard</h1>
    <p>Review standings by group and move through the tournament workflow.</p>
  </div>
</section>

<section class="grid">
  <% @groups.each do |group| %>
    <article class="card">
      <div class="section-title">
        <h2>Group <%= group.letter %></h2>
        <%= link_to "View group", group_path(group), class: "button button-small" %>
      </div>

      <table>
        <thead>
          <tr>
            <th>#</th>
            <th>Team</th>
            <th>Pts</th>
            <th>GD</th>
          </tr>
        </thead>
        <tbody>
          <% GroupStandingService.new(group).call.each_with_index do |team, index| %>
            <tr>
              <td><%= index + 1 %></td>
              <td><%= team.name %></td>
              <td><%= team.points %></td>
              <td><%= team.goal_difference %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </article>
  <% end %>
</section>
