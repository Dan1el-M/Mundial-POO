<%= form_with url: actualizar_resultados_fase_eliminatoria_path, method: :patch, local: true, class: 'flex flex-col gap-6' do %>
  <!-- Header Section -->
  <header class="flex justify-between items-center mb-8 px-container-padding pt-base">
    <div>
      <h2 class="font-headline-lg text-headline-lg text-primary uppercase tracking-tight">Fase Eliminatoria</h2>
      <p class="text-body-lg text-outline">Gestión global de llaves y avance automático del torneo</p>
    </div>
    <div class="flex flex-col sm:flex-row gap-3">
      <% if @resultados_disponibles %>
        <%= link_to podio_campeones_path, class: "bg-surface-container-high text-primary px-6 py-3 rounded-full font-bold flex items-center justify-center gap-2 hover:bg-outline-variant transition-all shadow-md active:scale-95" do %>
          <span class="material-symbols-outlined">leaderboard</span>
          Ver resultados
        <% end %>
      <% end %>
      <% if @podio_ready %>
        <button type="button" id="mostrar-podio-btn" class="bg-[#D97706] text-white px-6 py-3 rounded-full font-bold flex items-center justify-center gap-2 hover:bg-[#F59E0B] transition-all shadow-md active:scale-95">
          <span class="material-symbols-outlined">emoji_events</span>
          Ver Podio
        </button>
      <% end %>
    </div>
  </header>

  <button type="submit" class="fixed bottom-6 right-6 z-40 bg-[#001B4D] text-white px-6 py-3 rounded-full font-bold flex items-center justify-center gap-2 hover:bg-primary transition-all shadow-xl active:scale-95">
    <span class="material-symbols-outlined">auto_mode</span>
    Avanzar de Fase Automáticamente
  </button>

  <% if alert.present? %>
    <div class="mx-container-padding mb-6 rounded-xl border border-error/30 bg-error-container px-5 py-4 text-on-error-container shadow-sm">
      <div class="flex items-start gap-3">
        <span class="material-symbols-outlined text-error">warning</span>
        <p class="font-semibold"><%= alert %></p>
      </div>
    </div>
  <% end %>

  <% if notice.present? %>
    <div class="mx-container-padding mb-6 rounded-xl border border-emerald-200 bg-emerald-50 px-5 py-4 text-emerald-800 shadow-sm">
      <div class="flex items-start gap-3">
        <span class="material-symbols-outlined text-emerald-600">check_circle</span>
        <p class="font-semibold"><%= notice %></p>
      </div>
    </div>
  <% end %>

  <div id="aviso-penales" class="hidden mx-container-padding mb-6 rounded-xl border border-error/30 bg-error-container px-5 py-4 text-on-error-container shadow-sm">
    <div class="flex items-start gap-3">
      <span class="material-symbols-outlined text-error">warning</span>
      <p id="aviso-penales-texto" class="font-semibold"></p>
    </div>
  </div>

  <% if @partidos_penales_empatados.present? %>
    <div class="mx-container-padding mb-6 rounded-xl border border-error/30 bg-error-container px-5 py-4 text-on-error-container shadow-sm">
      <div class="flex items-start gap-3">
        <span class="material-symbols-outlined text-error">warning</span>
        <div>
          <p class="font-bold">Debes corregir el marcador por penales antes de avanzar.</p>
          <p class="text-sm mt-1">
            Los penales no pueden quedar empatados en:
            <%= @partidos_penales_empatados.map { |partido| "P#{partido.numero_partido}" }.join(", ") %>.
          </p>
        </div>
      </div>
    </div>
  <% end %>

  <% if @podio_ready %>
    <div id="podio-modal" class="hidden fixed inset-0 z-50 bg-black/50 backdrop-blur-sm flex items-center justify-center p-6">
      <div class="bg-white rounded-3xl shadow-2xl w-full max-w-3xl overflow-hidden">
        <div class="flex justify-between items-center px-6 py-4 border-b border-surface-variant">
          <div>
            <h3 class="text-headline-sm font-bold">Podio Final</h3>
            <p class="text-sm text-on-surface-variant">Resultados definitivos de la final y el partido por el tercer lugar</p>
          </div>
          <button type="button" id="cerrar-podio-btn" class="text-on-surface-variant hover:text-on-surface text-2xl leading-none">×</button>
        </div>
        <div class="px-6 py-8 grid gap-6 sm:grid-cols-3">
          <div class="bg-surface-container-highest rounded-3xl p-6 text-center">
            <div class="text-5xl mb-4">🥇</div>
            <p class="text-sm text-on-surface-variant uppercase tracking-[.18em] mb-2">Campeón</p>
            <p class="font-bold text-lg"><%= @podio[:campeon]&.nombre || 'Sin definir' %></p>
          </div>
          <div class="bg-surface-container-highest rounded-3xl p-6 text-center">
            <div class="text-5xl mb-4">🥈</div>
            <p class="text-sm text-on-surface-variant uppercase tracking-[.18em] mb-2">Subcampeón</p>
            <p class="font-bold text-lg"><%= @podio[:subcampeon]&.nombre || 'Sin definir' %></p>
          </div>
          <div class="bg-surface-container-highest rounded-3xl p-6 text-center">
            <div class="text-5xl mb-4">🥉</div>
            <p class="text-sm text-on-surface-variant uppercase tracking-[.18em] mb-2">Tercer Lugar</p>
            <p class="font-bold text-lg"><%= @podio[:tercero]&.nombre || 'Sin definir' %></p>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Bracket Canvas -->
  <div class="relative custom-scrollbar overflow-x-auto pb-12 px-container-padding">
  <div class="inline-flex gap-16 min-w-max py-8">
    <% @etapas_etiquetas.each do |etapa, etiqueta| %>
      <section class="flex flex-col gap-8 w-64">
        <h3 class="text-center font-bold text-outline-variant text-label-sm uppercase tracking-widest border-b border-outline-variant pb-2 mb-4"><%= etiqueta %></h3>
        <div class="space-y-12">
          <% partidos = @partidos_por_etapa[etapa] || [] %>
          <% if partidos.any? %>
            <% partidos.each do |partido| %>
              <% estado_class = partido_estado_class(partido) %>
              <% editable = !partido.finalizado? %>
              <% penales_editable = editable && partido.goles_local.present? && partido.goles_visitante.present? && partido.goles_local == partido.goles_visitante %>
              <div class="match-node <%= partido.finalizado? ? 'connector-down active-connector' : 'connector-up' %>">
                <div class="bg-white border border-outline-variant rounded-xl shadow-sm overflow-hidden w-full">
                  <div class="flex justify-between items-center p-3 border-b border-surface-container-highest <%= partido.finalizado? ? 'bg-secondary-container/10' : '' %>">
                    <div class="flex items-center gap-2">
                      <span class="w-2 h-2 rounded-full <%= estado_class %>"></span>
                      <span class="text-[10px] font-bold text-primary"><%= partido_estado_label(partido) %></span>
                    </div>
                    <span class="text-[10px] text-outline font-bold" data-numero-partido="true">P<%= partido.numero_partido %></span>
                  </div>
                  <div class="p-3 space-y-4 partido-row" data-partido-id="<%= partido.id %>">
                    <div class="grid grid-cols-12 gap-3 items-center">
                      <div class="col-span-5 flex items-center gap-2 text-black font-bold">
                        <%= bandera_seleccion(partido.seleccion_local, wrapper_class: "w-7 h-5 rounded-sm shrink-0", text_class: "text-[10px]") %>
                        <span><%= partido.seleccion_local.acronimo %></span>
                      </div>
                      <div class="col-span-2 text-center text-sm text-outline-variant">vs</div>
                      <div class="col-span-5 flex items-center justify-end gap-2 text-black font-bold">
                        <span><%= partido.seleccion_visitante.acronimo %></span>
                        <%= bandera_seleccion(partido.seleccion_visitante, wrapper_class: "w-7 h-5 rounded-sm shrink-0", text_class: "text-[10px]") %>
                      </div>
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                      <div class="space-y-1">
                        <label class="block text-[11px] uppercase tracking-[.18em] text-outline-variant" for="resultados_<%= partido.id %>_goles_local">Goles Local</label>
                        <input type="number" name="resultados[<%= partido.id %>][goles_local]" id="resultados_<%= partido.id %>_goles_local" min="0" class="w-full rounded-lg border border-outline-variant px-3 py-2" value="<%= partido.goles_local %>" data-gol-local="true" <%= 'disabled' unless editable %> />
                      </div>
                      <div class="space-y-1">
                        <label class="block text-[11px] uppercase tracking-[.18em] text-outline-variant" for="resultados_<%= partido.id %>_goles_visitante">Goles Visitante</label>
                        <input type="number" name="resultados[<%= partido.id %>][goles_visitante]" id="resultados_<%= partido.id %>_goles_visitante" min="0" class="w-full rounded-lg border border-outline-variant px-3 py-2" value="<%= partido.goles_visitante %>" data-gol-visitante="true" <%= 'disabled' unless editable %> />
                      </div>
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                      <div class="space-y-1">
                        <label class="block text-[11px] uppercase tracking-[.18em] text-outline-variant" for="resultados_<%= partido.id %>_goles_penales_local">Penales Local</label>
                        <input type="number" name="resultados[<%= partido.id %>][goles_penales_local]" id="resultados_<%= partido.id %>_goles_penales_local" min="0" class="w-full rounded-lg border border-outline-variant px-3 py-2" value="<%= partido.goles_penales_local %>" data-penales="true" <%= 'disabled' unless penales_editable %> />
                      </div>
                      <div class="space-y-1">
                        <label class="block text-[11px] uppercase tracking-[.18em] text-outline-variant" for="resultados_<%= partido.id %>_goles_penales_visitante">Penales Visitante</label>
                        <input type="number" name="resultados[<%= partido.id %>][goles_penales_visitante]" id="resultados_<%= partido.id %>_goles_penales_visitante" min="0" class="w-full rounded-lg border border-outline-variant px-3 py-2" value="<%= partido.goles_penales_visitante %>" data-penales="true" <%= 'disabled' unless penales_editable %> />
                      </div>
                    </div>
                    <% if partido.finalizado? && partido.goles_penales_local.present? %>
                      <div class="text-xs text-on-surface-variant">Penales: <%= partido.goles_penales_local %> - <%= partido.goles_penales_visitante %></div>
                    <% elsif editable %>
                      <div class="text-xs text-on-surface-variant">Penales solo se activan si el marcador termina empatado.</div>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
          <% else %>
            <div class="bg-surface-container-low border border-dashed border-outline-variant rounded-xl w-full h-32 flex flex-col items-center justify-center text-outline-variant">
              <span class="material-symbols-outlined text-4xl mb-2">pending</span>
              <span class="text-label-sm">No hay partidos generados para esta etapa.</span>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>
</div>
<% end %>
<script>
  document.querySelectorAll('.match-node').forEach(node => {
    node.addEventListener('mouseenter', () => {
      node.style.transform = 'scale(1.02)';
      node.style.transition = 'transform 0.2s ease-out';
    });
    node.addEventListener('mouseleave', () => {
      node.style.transform = 'scale(1)';
    });
  });

  const botonPodio = document.getElementById('mostrar-podio-btn');
  const modalPodio = document.getElementById('podio-modal');
  const cerrarPodio = document.getElementById('cerrar-podio-btn');

  if (botonPodio && modalPodio && cerrarPodio) {
    botonPodio.addEventListener('click', () => {
      modalPodio.classList.remove('hidden');
    });

    cerrarPodio.addEventListener('click', () => {
      modalPodio.classList.add('hidden');
    });

    modalPodio.addEventListener('click', (event) => {
      if (event.target === modalPodio) {
        modalPodio.classList.add('hidden');
      }
    });
  }

  function actualizarEstadoPenales(input) {
    const row = input.closest('.partido-row');
    if (!row) return;

    const golesLocal = parseInt(row.querySelector('input[data-gol-local]').value, 10);
    const golesVisitante = parseInt(row.querySelector('input[data-gol-visitante]').value, 10);
    const penales = row.querySelectorAll('input[data-penales]');
    const empate = !Number.isNaN(golesLocal) && !Number.isNaN(golesVisitante) && golesLocal === golesVisitante;

    penales.forEach((field) => {
      field.disabled = !empate;
      if (!empate) {
        field.value = '';
      }
    });
  }

  document.querySelectorAll('input[data-gol-local], input[data-gol-visitante]').forEach((input) => {
    input.addEventListener('input', (event) => {
      actualizarEstadoPenales(event.currentTarget);
    });
  });

  function mostrarAvisoPenales(mensaje) {
    const aviso = document.getElementById('aviso-penales');
    const texto = document.getElementById('aviso-penales-texto');
    if (!aviso || !texto) return;

    texto.textContent = mensaje;
    aviso.classList.remove('hidden');
    aviso.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  function partidosConPenalesInvalidos() {
    const invalidos = [];

    document.querySelectorAll('.partido-row').forEach((row) => {
      const golesLocalInput = row.querySelector('input[data-gol-local]');
      const golesVisitanteInput = row.querySelector('input[data-gol-visitante]');
      const penales = row.querySelectorAll('input[data-penales]');
      if (!golesLocalInput || !golesVisitanteInput || penales.length < 2) return;

      const golesLocal = parseInt(golesLocalInput.value, 10);
      const golesVisitante = parseInt(golesVisitanteInput.value, 10);
      const penalesLocal = parseInt(penales[0].value, 10);
      const penalesVisitante = parseInt(penales[1].value, 10);

      if (Number.isNaN(golesLocal) || Number.isNaN(golesVisitante) || golesLocal !== golesVisitante) return;
      if (Number.isNaN(penalesLocal) || Number.isNaN(penalesVisitante)) return;
      if (penalesLocal !== penalesVisitante) return;

      const numero = row.closest('.match-node')?.querySelector('[data-numero-partido]')?.textContent?.trim() || 'un partido';
      invalidos.push(numero);
    });

    return invalidos;
  }

  document.querySelector('form[action="<%= actualizar_resultados_fase_eliminatoria_path %>"]')?.addEventListener('submit', (event) => {
    const invalidos = partidosConPenalesInvalidos();
    if (invalidos.length === 0) return;

    event.preventDefault();
    mostrarAvisoPenales(`Debes cambiar el marcador por penales en ${invalidos.join(', ')}. Los penales no pueden quedar empatados.`);
  });
</script>
