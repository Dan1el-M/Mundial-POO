<%= render "shared/errors", resource: knockout_match %>

<%= form_with model: knockout_match, class: "stack" do |form| %>
  <div class="field-grid">
    <div class="field">
      <label>Home team</label>
      <input type="text" value="<%= knockout_match.home_team.name %>" disabled>
    </div>
    <div class="field">
      <label>Away team</label>
      <input type="text" value="<%= knockout_match.away_team.name %>" disabled>
    </div>
  </div>

  <div class="field-grid">
    <div class="field">
      <%= form.label :home_score, "Home goals" %>
      <%= form.number_field :home_score, min: 0, required: true %>
    </div>
    <div class="field">
      <%= form.label :away_score, "Away goals" %>
      <%= form.number_field :away_score, min: 0, required: true %>
    </div>
  </div>

  <div class="field-grid">
    <div class="field">
      <%= form.label :home_penalty_score, "Home penalties" %>
      <%= form.number_field :home_penalty_score, min: 0 %>
    </div>
    <div class="field">
      <%= form.label :away_penalty_score, "Away penalties" %>
      <%= form.number_field :away_penalty_score, min: 0 %>
    </div>
  </div>

  <div class="actions">
    <%= form.submit "Save result", class: "button" %>
    <%= link_to "Back", knockout_matches_path, class: "button button-secondary" %>
  </div>
<% end %>
