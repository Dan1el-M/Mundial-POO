<div class="min-h-screen bg-surface-container-lowest p-container-padding">
  <nav class="flex items-center gap-2 mb-6 text-on-surface-variant font-label-sm text-label-sm">
    <%= link_to "Inicio", root_path, class: "hover:text-primary transition-colors" %>
    <span class="material-symbols-outlined text-[16px]">chevron_right</span>
    <%= link_to "Grupos", selecciones_path, class: "hover:text-primary transition-colors" %>
    <span class="material-symbols-outlined text-[16px]">chevron_right</span>
    <span class="text-primary font-bold">Detalles del Grupo <%= @grupo.letra %></span>
  </nav>

  <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8">
    <div>
      <h1 class="font-headline-lg text-headline-lg text-primary">Detalles del Grupo <%= @grupo.letra %></h1>
    </div>
    <div class="flex gap-3">
      <%= link_to "Gestionar Selecciones", selecciones_path, class: "px-4 py-2 rounded-lg border border-outline-variant text-primary hover:bg-surface-container-high transition-all" %>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-card-gap mb-8">
    <div class="bg-surface-container-lowest border border-outline-variant p-6 rounded-xl shadow-sm">
      <div class="flex items-center gap-3 mb-4 text-primary">
        <span class="material-symbols-outlined">flag</span>
        <h3 class="font-title-lg text-title-lg font-bold">Selecciones Totales</h3>
      </div>
      <p class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Selecciones Totales</p>
      <p class="font-headline-md text-headline-md text-primary mt-2"><%= @grupo.selecciones.size %> / 4</p>
    </div>

    <div class="bg-surface-container-lowest border border-outline-variant p-6 rounded-xl shadow-sm">
      <div class="flex items-center gap-3 mb-4 text-primary">
        <span class="material-symbols-outlined text-green-700" style="font-variation-settings: 'FILL' 1;">check_circle</span>
        <h3 class="font-title-lg text-title-lg font-bold">Estado</h3>
      </div>
      <p class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Estado</p>
      <% if @grupo.completo? %>
        <p class="font-headline-md text-headline-md text-green-700 mt-2">Completo</p>
      <% else %>
        <p class="font-headline-md text-headline-md text-red-600 mt-2">Incompleto</p>
        <p class="text-sm text-on-surface-variant mt-1"><%= @grupo.selecciones.size %> / 4 selecciones</p>
      <% end %>
    </div>

    <div class="bg-surface-container-lowest border border-outline-variant p-6 rounded-xl shadow-sm">
      <div class="flex items-center gap-3 mb-4 text-primary">
        <span class="material-symbols-outlined">sports_soccer</span>
        <h3 class="font-title-lg text-title-lg font-bold">Partidos</h3>
      </div>
      <p class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Finalizados / Totales</p>
      <p class="font-headline-md text-headline-md text-primary mt-2"><%= @partidos_finalizados %> / <%= @partidos.size %></p>
    </div>
  </div>

  <div class="bg-surface-container-lowest border border-outline-variant rounded-xl shadow-sm overflow-hidden mb-section-margin">
    <div class="p-4 border-b border-outline-variant bg-surface-container-low flex justify-between items-center">
      <div class="flex items-center gap-2">
        <span class="material-symbols-outlined text-primary">filter_list</span>
        <span class="font-title-lg text-title-lg text-primary">Selecciones Asignadas</span>
      </div>
    </div>

    <div class="p-4 overflow-x-auto">
      <table class="w-full text-left min-w-[720px]">
        <thead class="bg-primary text-on-primary font-headline-md text-label-sm uppercase tracking-widest">
          <tr>
            <th class="px-6 py-4">Nombre del Pais</th>
            <th class="px-6 py-4">Siglas</th>
            <th class="px-6 py-4">Pts</th>
            <th class="px-6 py-4">GF/GC</th>
            <th class="px-6 py-4">Estado</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-outline-variant bg-white">
          <% @selecciones.each do |seleccion| %>
            <tr class="hover:bg-surface-container-low transition-colors">
              <td class="px-6 py-4">
                <div class="font-title-lg text-body-lg font-bold text-primary"><%= seleccion.nombre %></div>
                <div class="text-label-sm text-on-surface-variant italic">Seleccion del Grupo <%= @grupo.letra %></div>
              </td>
              <td class="px-6 py-4">
                <span class="bg-surface-container-highest px-3 py-1 rounded font-black text-primary"><%= seleccion.acronimo.present? ? seleccion.acronimo.upcase : seleccion.nombre.first(3).upcase %></span>
              </td>
              <td class="px-6 py-4 font-bold"><%= seleccion.puntos %></td>
              <td class="px-6 py-4 text-on-surface-variant"><%= seleccion.goles_favor %> / <%= seleccion.goles_contra %></td>
              <td class="px-6 py-4">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-green-100 text-green-800 text-label-sm font-bold">
                  <span class="w-2 h-2 rounded-full bg-green-600"></span>
                  Activo
                </span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
