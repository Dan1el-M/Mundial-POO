<header class="mb-section-margin">
  <h1 class="font-headline-lg text-headline-lg text-primary-container">Partidos de Fase de Grupos</h1>
  <p class="font-body-md text-body-md text-on-surface-variant mt-2">
    Revisa que cada grupo tenga 4 selecciones y genera los 6 partidos de cada grupo.
  </p>
</header>

<% if notice.present? %>
  <div class="mb-gutter bg-emerald-50 border border-emerald-200 text-emerald-800 px-5 py-4 rounded-xl font-semibold">
    <%= notice %>
  </div>
<% end %>

<% if alert.present? %>
  <div class="mb-gutter bg-error-container border border-error/20 text-on-error-container px-5 py-4 rounded-xl font-semibold">
    <%= alert %>
  </div>
<% end %>

<section class="mb-card-gap">
  <% if @grupos_incompletos.any? %>
    <div class="bg-error-container border border-error/20 p-6 rounded-xl flex items-center gap-6 mb-card-gap shadow-sm">
      <div class="bg-error text-white w-16 h-16 rounded-full flex items-center justify-center flex-shrink-0">
        <span class="material-symbols-outlined text-[32px]">warning</span>
      </div>
      <div>
        <h3 class="font-headline-md text-headline-md text-on-error-container mb-1">Grupos incompletos</h3>
        <p class="font-body-md text-body-md text-on-error-container opacity-90">
          Hay <%= @grupos_incompletos.size %> grupo(s) sin 4 selecciones. Completa los grupos antes de generar el calendario.
        </p>
      </div>
    </div>
  <% else %>
    <div class="bg-emerald-50 border border-emerald-200 p-6 rounded-xl flex items-center gap-6 mb-card-gap shadow-sm">
      <div class="bg-emerald-600 text-white w-16 h-16 rounded-full flex items-center justify-center flex-shrink-0">
        <span class="material-symbols-outlined text-[32px]">check_circle</span>
      </div>
      <div>
        <h3 class="font-headline-md text-headline-md text-black mb-1 font-black">Todos los grupos completos</h3>
        <p class="font-body-md text-body-md text-black opacity-90">
          Ya puedes generar o revisar el calendario de fase de grupos.
        </p>
      </div>
    </div>
  <% end %>
</section>

<section class="mb-card-gap">
  <div class="flex justify-between items-end mb-6">
    <h4 class="font-title-lg text-title-lg text-primary flex items-center gap-2">
      Estado por grupos
      <span class="bg-surface-container-high text-on-surface-variant px-3 py-1 rounded-full text-label-sm">
        <%= @total_registrado %> / <%= @total_requerido %> selecciones
      </span>
    </h4>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <% @grupos.each do |grupo| %>
      <% completo = grupo.completo? %>
      <% partidos_count = grupo.partidos.count %>
      <div class="bg-white p-5 rounded-lg border border-outline-variant shadow-sm <%= completo ? 'border-l-4 border-l-emerald-500' : 'border-l-4 border-l-error' %>">
        <div class="flex justify-between items-start mb-4">
          <span class="font-display-lg text-[28px] text-primary">Grupo <%= grupo.letra %></span>
          <span class="material-symbols-outlined <%= completo ? 'text-green-500' : 'text-error' %>">
            <%= completo ? 'check_circle' : 'error' %>
          </span>
        </div>

        <p class="text-label-sm font-label-sm <%= completo ? 'text-green-600' : 'text-error' %> mb-2 uppercase">
          <%= completo ? 'Completo' : 'Incompleto' %> (<%= grupo.selecciones.size %>/4)
        </p>

        <% if grupo.selecciones.any? %>
          <p class="font-body-md text-body-md text-on-surface-variant mb-3">
            <%= grupo.selecciones.map { |seleccion| seleccion.acronimo.presence || seleccion.nombre.first(3).upcase }.join(", ") %>
          </p>
        <% else %>
          <p class="font-body-md text-body-md text-on-surface-variant mb-3">Sin selecciones registradas.</p>
        <% end %>

        <p class="font-label-sm text-label-sm text-on-surface-variant">
          Partidos programados: <strong><%= partidos_count %>/6</strong>
        </p>
      </div>
    <% end %>
  </div>
</section>

<div class="mt-8 pt-6 border-t border-outline-variant flex flex-col sm:flex-row sm:justify-between sm:items-center gap-4">
  <div class="flex items-center gap-2 text-on-surface-variant font-body-md text-body-md">
    <span class="material-symbols-outlined">info</span>
    <% if @grupos_incompletos.any? %>
      Completa las selecciones faltantes para habilitar la generación automática.
    <% else %>
      Cada grupo completo genera 6 partidos: todos contra todos una vez.
    <% end %>
  </div>

  <div class="flex flex-wrap gap-4">
    <%= link_to "Gestionar selecciones",
                selecciones_path,
                class: "bg-primary-container text-on-primary-container px-6 py-3 rounded-lg font-title-lg text-title-lg hover:bg-opacity-90 transition-all" %>

    <%= link_to "Ver calendario",
                calendario_partidos_grupo_path,
                class: "bg-surface-container-high text-primary px-6 py-3 rounded-lg font-title-lg text-title-lg hover:bg-outline-variant transition-all" %>

    <% if @grupos_incompletos.any? %>
      <button class="bg-outline text-white/50 px-8 py-3 rounded-lg font-title-lg text-title-lg cursor-not-allowed" disabled>
        Generar calendario
      </button>
    <% else %>
      <%= button_to "Generar calendario",
                    generar_calendario_partidos_grupo_path,
                    method: :post,
                    class: "bg-primary text-white px-8 py-3 rounded-lg font-title-lg text-title-lg" %>
    <% end %>
  </div>
</div>
